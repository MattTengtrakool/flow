# Copy this file to .env or export these values before launching Flow.
# Local Electron runs default to the dev profile. Set FLOW_APP_PROFILE=prod only
# when you intentionally want to point a local run at the production app data.
FLOW_APP_PROFILE=dev

# Local dev mode routes managed AI calls inside Electron.
# Hosted mode replaces "local" with your hosted Flow AI relay URL.
FLOW_AI_PROXY_URL=local
FLOW_AI_PROXY_TOKEN=

# Local dev adapter keys. Do not ship these in a packaged app.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
# Some Google desktop clients still require this during token exchange.
GOOGLE_OAUTH_CLIENT_SECRET=
# Register this exact URI if using a Google "Web application" OAuth client:
# http://127.0.0.1:53682/
GOOGLE_OAUTH_REDIRECT_PORT=53682
